{
  "name": "@sensrbio/openmhealth",
  "version": "0.1.0",
  "description": "Sensr Bio (Sensr) → Open mHealth (OMH) JSON schema converter",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sensr-to-omh": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx examples/export-user-data.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && npm run test"
  },
  "dependencies": {
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "vitest": {
    "test": {
      "environment": "node"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "open-mhealth",
    "omh",
    "sensr",
    "wearables",
    "health-data",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://example.com/sensrbio-openmhealth"
  }
}
